flowchart TD
    classDef highlight fill:#d3d3d3,stroke:#ff0000,stroke-width:2px,stroke-dasharray:5 5
    classDef pk font-weight:bold,fill:#f0f0f0

    eProduct[PRODUCT]
    eCategory[CATEGORY]
    eSupplier[SUPPLIER]
    eStockMovement[STOCK MOVEMENT]
    ePurchaseOrder[PURCHASE ORDER]
    ePurchaseOrderLine[PURCHASE ORDER LINE]

    rBelongsTo[s1]
    rSuppliedBy[s2]
    rTracks[s3]
    rHasLines[s4]
    rIncludesProduct[s5]

    aProId((id)):::underline
    aProSku((sku))
    aProName((name))
    aProCatId((category_id))
    aProUnitPrice((unit_price))
    aProCostPrice((cost_price))
    aProReorderLvl((reorder_level))
    aProImageUrl((image_url))
    aProIsActive((is_active))

    aCatId((id)):::underline
    aCatName((name))
    aCatDesc((description))
    aCatParentId((parent_id))

    aSupId((id)):::underline
    aSupName((name))
    aSupContact((contact_person))
    aSupEmail((email))
    aSupPhone((phone))
    aSupAddress((address))
    aSupIsActive((is_active))

    aSMId((id)):::underline
    aSMProdId((product_id))
    aSMType((type))
    aSMQty((quantity))
    aSMRefType((reference_type))
    aSMRefId((reference_id))
    aSMDate((date))
    aSMNotes((notes))

    aPOId((id)):::underline
    aPOPoNum((po_number))
    aPOSupId((supplier_id))
    aPODate((date))
    aPOStatus((status))
    aPOTotal((total_amount))
    aPOExpDate((expected_date))

    aPOLId((id)):::underline
    aPOLOrderId((order_id))
    aPOLProdId((product_id))
    aPOLQty((quantity))
    aPOLUnitPrice((unit_price))
    aPOLLineTotal((line_total))
    aPOLRecQty((received_qty))

    eProduct --- aProId
    eProduct --- aProSku
    eProduct --- aProName
    eProduct --- aProCatId
    eProduct --- aProUnitPrice
    eProduct --- aProCostPrice
    eProduct --- aProReorderLvl
    eProduct --- aProImageUrl
    eProduct --- aProIsActive

    eCategory --- aCatId
    eCategory --- aCatName
    eCategory --- aCatDesc
    eCategory --- aCatParentId

    eSupplier --- aSupId
    eSupplier --- aSupName
    eSupplier --- aSupContact
    eSupplier --- aSupEmail
    eSupplier --- aSupPhone
    eSupplier --- aSupAddress
    eSupplier --- aSupIsActive

    eStockMovement --- aSMId
    eStockMovement --- aSMProdId
    eStockMovement --- aSMType
    eStockMovement --- aSMQty
    eStockMovement --- aSMRefType
    eStockMovement --- aSMRefId
    eStockMovement --- aSMDate
    eStockMovement --- aSMNotes

    ePurchaseOrder --- aPOId
    ePurchaseOrder --- aPOPoNum
    ePurchaseOrder --- aPOSupId
    ePurchaseOrder --- aPODate
    ePurchaseOrder --- aPOStatus
    ePurchaseOrder --- aPOTotal
    ePurchaseOrder --- aPOExpDate

    ePurchaseOrderLine --- aPOLId
    ePurchaseOrderLine --- aPOLOrderId
    ePurchaseOrderLine --- aPOLProdId
    ePurchaseOrderLine --- aPOLQty
    ePurchaseOrderLine --- aPOLUnitPrice
    ePurchaseOrderLine --- aPOLLineTotal
    ePurchaseOrderLine --- aPOLRecQty

    eCategory -->|1| rBelongsTo -->|N| eProduct
    eSupplier -->|1| rSuppliedBy -->|N| eProduct
    eProduct -->|1| rTracks -->|N| eStockMovement
    ePurchaseOrder -->|1| rHasLines -->|N| ePurchaseOrderLine
    ePurchaseOrderLine -->|N| rIncludesProduct -->|1| eProduct