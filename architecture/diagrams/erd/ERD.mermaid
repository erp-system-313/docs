flowchart TD
    classDef highlight fill:#d3d3d3,stroke:#ff0000,stroke-width:2px,stroke-dasharray:5 5
    classDef underline text-decoration:underline

    eUser[USER]
    eCustomer[CUSTOMER]
    eCategory[CATEGORY]
    eProduct[PRODUCT]
    eSupplier[SUPPLIER]
    eStockMovement[STOCK MOVEMENT]
    eSalesOrder[SALES ORDER]
    eSalesOrderLine[SALES ORDER LINE]
    ePurchaseOrder[PURCHASE ORDER]
    ePurchaseOrderLine[PURCHASE ORDER LINE]
    eInvoice[INVOICE]
    ePayment[PAYMENT]
    eJournalEntry[JOURNAL ENTRY]
    eJournalEntryLine[JOURNAL ENTRY LINE]
    eAccount[ACCOUNT]

    rCreates[s01]
    rPlaces[s02]
    rBelongsTo[s03]
    rHasParent[s04]
    rContains[s05]
    rGenerates[s06]
    rReceived[s07]
    rReceives[s08]
    rSuppliedBy[s09]
    rTracks[s10]
    rHasLines[s11]
    rIncludesProduct[s12]

    aUId((id)):::underline
    aUName((name))
    aUEmail((email))
    aUPassword((password))
    aURole((role))
    aUCAt((created_at))

    aCId((id)):::underline
    aCName((name))
    aCEmail((email))
    aCPhone((phone))
    aCAddress((address))
    aCCLimit((credit_limit))
    aCcActive((is_active))
    aCpTerms((payment_terms))
    aCCAt((created_at))

    aCatId((id)):::underline
    aCatName((name))
    aCatDesc((description))
    aCatParentId((parent_id))

    aProId((id)):::underline
    aProSku((sku))
    aProName((name))
    aProCatId((category_id))
    aProUnitPrice((unit_price))
    aProCostPrice((cost_price))
    aProReorderLvl((reorder_level))
    aProImageUrl((image_url))
    aProIsActive((is_active))

    aSupId((id)):::underline
    aSupName((name))
    aSupContact((contact_person))
    aSupEmail((email))
    aSupPhone((phone))
    aSupAddress((address))
    aSupIsActive((is_active))

    aSMId((id)):::underline
    aSMProdId((product_id))
    aSMType((type))
    aSMQty((quantity))
    aSMRefType((reference_type))
    aSMRefId((reference_id))
    aSMDate((date))
    aSMNotes((notes))

    aSOid((id)):::underline
    aSOstatus((status))
    aSOdate((date))
    aSOoNum((order_number))
    aSOcId((customer_id))
    aSOta((total_amount))
    aSOnotes((notes))

    aSOLid((id)):::underline
    aSOLoid((order_id))
    aSOLpId((product_id))
    aSOLqty((quantity))
    aSOLprice((unit_price))
    aSOLlineT((line_total))

    aPOId((id)):::underline
    aPOPoNum((po_number))
    aPOSupId((supplier_id))
    aPODate((date))
    aPOStatus((status))
    aPOTotal((total_amount))
    aPOExpDate((expected_date))

    aPOLId((id)):::underline
    aPOLOrderId((order_id))
    aPOLProdId((product_id))
    aPOLQty((quantity))
    aPOLUnitPrice((unit_price))
    aPOLLineTotal((line_total))
    aPOLRecQty((received_qty))

    aIid((id)):::underline
    aInum((invoice_number))
    aIsoid((sales_order_id))
    aIdate((date))
    aIdDue((due_date))
    aIstatus((status))
    aItotal((total))
    aItax((tax_amount))

    aPid((id)):::underline
    aPinvId((invoice_id))
    aPdate((date))
    aPmethod((method))
    aPref((reference))
    aPnotes((notes))

    aJEid((id)):::underline
    aJEdate((date))
    aJEdesc((description))
    aJEref((reference))
    aJEstatus((status))
    aJEcBy((created_by))
    aJEcAt((created_at))

    aJELid((id)):::underline
    aJELeid((entry_id))
    aJELaid((account_id))
    aJELdeb((debit))
    aJELcred((credit))

    aAid((id)):::underline
    aAcode((code))
    aAname((name))
    aAtype((type))
    aAparent((parent_id))
    aAbal((balance))

    eUser --- aUId
    eUser --- aUName
    eUser --- aUEmail
    eUser --- aUPassword
    eUser --- aURole
    eUser --- aUCAt

    eCustomer --- aCId
    eCustomer --- aCName
    eCustomer --- aCEmail
    eCustomer --- aCPhone
    eCustomer --- aCAddress
    eCustomer --- aCCLimit
    eCustomer --- aCcActive
    eCustomer --- aCpTerms
    eCustomer --- aCCAt

    eCategory --- aCatId
    eCategory --- aCatName
    eCategory --- aCatDesc
    eCategory --- aCatParentId

    eProduct --- aProId
    eProduct --- aProSku
    eProduct --- aProName
    eProduct --- aProCatId
    eProduct --- aProUnitPrice
    eProduct --- aProCostPrice
    eProduct --- aProReorderLvl
    eProduct --- aProImageUrl
    eProduct --- aProIsActive

    eSupplier --- aSupId
    eSupplier --- aSupName
    eSupplier --- aSupContact
    eSupplier --- aSupEmail
    eSupplier --- aSupPhone
    eSupplier --- aSupAddress
    eSupplier --- aSupIsActive

    eStockMovement --- aSMId
    eStockMovement --- aSMProdId
    eStockMovement --- aSMType
    eStockMovement --- aSMQty
    eStockMovement --- aSMRefType
    eStockMovement --- aSMRefId
    eStockMovement --- aSMDate
    eStockMovement --- aSMNotes

    eSalesOrder --- aSOid
    eSalesOrder --- aSOstatus
    eSalesOrder --- aSOdate
    eSalesOrder --- aSOoNum
    eSalesOrder --- aSOcId
    eSalesOrder --- aSOta
    eSalesOrder --- aSOnotes

    eSalesOrderLine --- aSOLid
    eSalesOrderLine --- aSOLoid
    eSalesOrderLine --- aSOLpId
    eSalesOrderLine --- aSOLqty
    eSalesOrderLine --- aSOLprice
    eSalesOrderLine --- aSOLlineT

    ePurchaseOrder --- aPOId
    ePurchaseOrder --- aPOPoNum
    ePurchaseOrder --- aPOSupId
    ePurchaseOrder --- aPODate
    ePurchaseOrder --- aPOStatus
    ePurchaseOrder --- aPOTotal
    ePurchaseOrder --- aPOExpDate

    ePurchaseOrderLine --- aPOLId
    ePurchaseOrderLine --- aPOLOrderId
    ePurchaseOrderLine --- aPOLProdId
    ePurchaseOrderLine --- aPOLQty
    ePurchaseOrderLine --- aPOLUnitPrice
    ePurchaseOrderLine --- aPOLLineTotal
    ePurchaseOrderLine --- aPOLRecQty

    eInvoice --- aIid
    eInvoice --- aInum
    eInvoice --- aIsoid
    eInvoice --- aIdate
    eInvoice --- aIdDue
    eInvoice --- aIstatus
    eInvoice --- aItotal
    eInvoice --- aItax

    ePayment --- aPid
    ePayment --- aPinvId
    ePayment --- aPdate
    ePayment --- aPmethod
    ePayment --- aPref
    ePayment --- aPnotes

    eJournalEntry --- aJEid
    eJournalEntry --- aJEdate
    eJournalEntry --- aJEdesc
    eJournalEntry --- aJEref
    eJournalEntry --- aJEstatus
    eJournalEntry --- aJEcBy
    eJournalEntry --- aJEcAt

    eJournalEntryLine --- aJELid
    eJournalEntryLine --- aJELeid
    eJournalEntryLine --- aJELaid
    eJournalEntryLine --- aJELdeb
    eJournalEntryLine --- aJELcred

    eAccount --- aAid
    eAccount --- aAcode
    eAccount --- aAname
    eAccount --- aAtype
    eAccount --- aAparent
    eAccount --- aAbal

    eUser -->|1| rCreates -->|N| eSalesOrder
    eCustomer -->|1| rPlaces -->|N| eSalesOrder
    eCategory -->|1| rBelongsTo -->|N| eProduct
    eProduct -->|N| rBelongsTo -->|1| eCategory
    eCategory -->|1| rHasParent -->|N| eCategory
    eSalesOrder -->|1| rContains -->|N| eSalesOrderLine
    eSalesOrder -->|1| rGenerates -->|N| eInvoice
    eSalesOrderLine -->|N| rBelongsTo -->|1| eProduct
    eInvoice -->|1| rReceived -->|N| ePayment
    eCustomer -->|1| rReceives -->|N| eInvoice
    eSupplier -->|1| rSuppliedBy -->|N| eProduct
    eProduct -->|1| rTracks -->|N| eStockMovement
    ePurchaseOrder -->|1| rHasLines -->|N| ePurchaseOrderLine
    ePurchaseOrderLine -->|N| rIncludesProduct -->|1| eProduct
    ePurchaseOrder -->|1| rSuppliedBy -->|N| eSupplier
    eJournalEntry -->|1| rCreates -->|N| eJournalEntryLine
    eJournalEntryLine -->|N| rBelongsTo -->|1| eAccount
    eAccount -->|1| rHasParent -->|N| eAccount
