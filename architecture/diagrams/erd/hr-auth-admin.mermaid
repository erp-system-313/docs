flowchart TD
    classDef highlight fill:#d3d3d3,stroke:#ff0000,stroke-width:2px,stroke-dasharray:5 5
    classDef underline text-decoration:underline

    eUser[USERS]
    eCustomer[CUSTOMERS]
    eCategory[CATEGORIES]
    eProduct[PRODUCTS]
    eOrder[ORDERS]
    eOrderItem[ORDER_ITEMS]
    eInvoice[INVOICES]
    ePayment[PAYMENTS]

    rCreates[s01]
    rPlaces[s02]
    rBelongsTo[s03]
    rHasParent[s04]
    rContains[s05]
    rGenerates[s06]
    rReceived[s07]
    rReceives[s08]

    aUId((id)):::underline
    aUName((name))
    aUEmail((email))
    aUPassword((password))
    aURole((role))
    aUCAt((created_at))

    aCId((id)):::underline
    aCName((name))
    aCEmail((email))
    aCPhone((phone))
    aCAddress((address))
    aCCLimit((credit_limit))
    aCCAt((created_at))

    aCatId((id)):::underline
    aCatName((name))
    aCatPId((parent_id))

    aPId((id)):::underline
    aPName((name))
    aPSku((sku))
    aPPrice((price))
    aPStock((stock))
    aPCatId((category_id))
    aPCAt((created_at))

    aOId((id)):::underline
    aOUserId((user_id))
    aOCustId((customer_id))
    aOTotal((total))
    aOStatus((status))
    aODate((order_date))
    aOCAt((created_at))

    aOIId((id)):::underline
    aOIOrdId((order_id))
    aOIProdId((product_id))
    aOIQty((quantity))
    aOIPrice((price))
    aOICAt((created_at))

    aIId((id)):::underline
    aIOrdId((order_id))
    aIAmount((amount))
    aIStatus((status))
    aIDueDate((due_date))
    aICAt((created_at))

    aPayId((id)):::underline
    aPayInvId((invoice_id))
    aPayAmount((amount))
    aPayDate((payment_date))
    aPayMethod((method))

    eUser --- aUId
    eUser --- aUName
    eUser --- aUEmail
    eUser --- aUPassword
    eUser --- aURole
    eUser --- aUCAt

    eCustomer --- aCId
    eCustomer --- aCName
    eCustomer --- aCEmail
    eCustomer --- aCPhone
    eCustomer --- aCAddress
    eCustomer --- aCCLimit
    eCustomer --- aCCAt

    eCategory --- aCatId
    eCategory --- aCatName
    eCategory --- aCatPId

    eProduct --- aPId
    eProduct --- aPName
    eProduct --- aPSku
    eProduct --- aPPrice
    eProduct --- aPStock
    eProduct --- aPCatId
    eProduct --- aPCAt

    eOrder --- aOId
    eOrder --- aOUserId
    eOrder --- aOCustId
    eOrder --- aOTotal
    eOrder --- aOStatus
    eOrder --- aODate
    eOrder --- aOCAt

    eOrderItem --- aOIId
    eOrderItem --- aOIOrdId
    eOrderItem --- aOIProdId
    eOrderItem --- aOIQty
    eOrderItem --- aOIPrice
    eOrderItem --- aOICAt

    eInvoice --- aIId
    eInvoice --- aIOrdId
    eInvoice --- aIAmount
    eInvoice --- aIStatus
    eInvoice --- aIDueDate
    eInvoice --- aICAt

    ePayment --- aPayId
    ePayment --- aPayInvId
    ePayment --- aPayAmount
    ePayment --- aPayDate
    ePayment --- aPayMethod

    eUser -->|1| rCreates -->|N| eOrder
    eCustomer -->|1| rPlaces -->|N| eOrder
    eOrder -->|1| rContains -->|N| eOrderItem
    eOrder -->|1| rGenerates -->|N| eInvoice
    eOrderItem -->|N| rBelongsTo -->|1| eProduct
    eProduct -->|N| rBelongsTo -->|1| eCategory
    eCategory -->|1| rHasParent -->|N| eCategory
    eInvoice -->|1| rReceived -->|N| ePayment
    eCustomer -->|1| rReceives -->|N| eInvoice

