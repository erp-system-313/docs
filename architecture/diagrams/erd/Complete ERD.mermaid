flowchart TD
    classDef entity fill:#e1f5fe,stroke:#01579b,stroke-width:2px
    classDef attr fill:#fff9c4,stroke:#fbc02d,stroke-width:1px
    classDef rel fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px

    %% ===== HR & CORE ENTITIES =====
    eUser[USER]:::entity
    eRole[ROLE]:::entity
    eEmployee[EMPLOYEE]:::entity
    eAttendance[ATTENDANCE]:::entity
    eLeaveRequest[LEAVE REQUEST]:::entity

    %% ===== SALES & ACCOUNTING ENTITIES =====
    eCustomer[CUSTOMER]:::entity
    eSalesOrder[SALES ORDER]:::entity
    eSalesOrderLine[SALES ORDER LINE]:::entity
    eInvoice[INVOICE]:::entity
    ePayment[PAYMENT]:::entity
    eJournalEntry[JOURNAL ENTRY]:::entity
    eJournalEntryLine[JOURNAL ENTRY LINE]:::entity
    eAccount[ACCOUNT]:::entity

    %% ===== INVENTORY & PURCHASING ENTITIES (BE1) =====
    eProduct[PRODUCT]:::entity
    eCategory[CATEGORY]:::entity
    eSupplier[SUPPLIER]:::entity
    eStockMovement[STOCK MOVEMENT]:::entity
    ePurchaseOrder[PURCHASE ORDER]:::entity
    ePurchaseOrderLine[PURCHASE ORDER LINE]:::entity

    %% ===== RELATIONSHIPS (Diamonds) =====
    %% HR Relationships
    rAssignedTo{assigned to}:::rel
    rHas{has}:::rel
    rRecordsAttendance{records}:::rel
    rSubmitsLeave{submits}:::rel

    %% Sales Relationships
    rPlaces{places}:::rel
    rContains{contains}:::rel
    rProductFor{product for}:::rel
    rGenerates{generates}:::rel
    rSettledBy{settled by}:::rel

    %% Accounting Relationships
    rRecordsTo{records to}:::rel
    rAffects{affects}:::rel
    rSubaccountOf{subaccount of}:::rel
    rCreatedBy{created by}:::rel

    %% Inventory Relationships
    rBelongsTo{belongs to}:::rel
    rSuppliedBy{supplied by}:::rel
    rTracks{tracks}:::rel
    rHasLines{has lines}:::rel
    rIncludesProduct{includes}:::rel

    %% Cross-module Relationships
    rManages{manages}:::rel
    rUpdatesStock{updates stock}:::rel

    %% ===== ATTRIBUTES (Ovals) =====
    %% User Attributes
    aUId([id]):::attr
    aUEmail([email]):::attr
    aUPassword([password_hash]):::attr
    aURoleId([role_id]):::attr
    aUEmpId([employee_id]):::attr
    aUActive([is_active]):::attr
    aUCAt([created_at]):::attr
    aUUpAt([updated_at]):::attr

    %% Role Attributes
    aRId([id]):::attr
    aRName([name]):::attr
    aRPermissions([permissions]):::attr

    %% Employee Attributes
    aEmpId([id]):::attr
    aEmpUserId([user_id]):::attr
    aEmpFirst([first_name]):::attr
    aEmpLast([last_name]):::attr
    aEmpEmail([email]):::attr
    aEmpPhone([phone]):::attr
    aEmpHireDate([hire_date]):::attr
    aEmpSalary([salary]):::attr
    aEmpDept([department]):::attr
    aEmpPos([position]):::attr

    %% Attendance Attributes
    aAttId([id]):::attr
    aAttEmpId([employee_id]):::attr
    aAttDate([date]):::attr
    aAttCheckIn([check_in]):::attr
    aAttCheckOut([check_out]):::attr
    aAttStatus([status]):::attr
    aAttNotes([notes]):::attr

    %% Leave Request Attributes
    aLRId([id]):::attr
    aLREmpId([employee_id]):::attr
    aLRStart([start_date]):::attr
    aLREnd([end_date]):::attr
    aLRType([type]):::attr
    aLRStatus([status]):::attr
    aLRReason([reason]):::attr
    aLRApprovedBy([approved_by]):::attr
    aLRApprovedAt([approved_at]):::attr

    %% Customer Attributes
    aCid([id]):::attr
    aCname([name]):::attr
    aCemail([email]):::attr
    aCphone([phone]):::attr
    aCaddress([address]):::attr
    aCcLimit([credit_limit]):::attr
    aCpTerms([payment_terms]):::attr
    aCcActive([is_active]):::attr

    %% Sales Order Attributes
    aSOid([id]):::attr
    aSOoNum([order_number]):::attr
    aSOcId([customer_id]):::attr
    aSOdate([date]):::attr
    aSOstatus([status]):::attr
    aSOta([total_amount]):::attr
    aSOnotes([notes]):::attr

    %% Sales Order Line Attributes
    aSOLid([id]):::attr
    aSOLoid([order_id]):::attr
    aSOLpId([product_id]):::attr
    aSOLqty([quantity]):::attr
    aSOLprice([unit_price]):::attr
    aSOLlineT([line_total]):::attr

    %% Invoice Attributes
    aIid([id]):::attr
    aInum([invoice_number]):::attr
    aIsoid([sales_order_id]):::attr
    aIdate([date]):::attr
    aIdDue([due_date]):::attr
    aIstatus([status]):::attr
    aItotal([total]):::attr
    aItax([tax_amount]):::attr

    %% Payment Attributes
    aPid([id]):::attr
    aPinvId([invoice_id]):::attr
    aPamount([amount]):::attr
    aPdate([date]):::attr
    aPmethod([method]):::attr
    aPref([reference]):::attr
    aPnotes([notes]):::attr

    %% Journal Entry Attributes
    aJEid([id]):::attr
    aJEdate([date]):::attr
    aJEdesc([description]):::attr
    aJEref([reference]):::attr
    aJEstatus([status]):::attr
    aJEcBy([created_by]):::attr
    aJEcAt([created_at]):::attr

    %% Journal Entry Line Attributes
    aJELid([id]):::attr
    aJELeid([entry_id]):::attr
    aJELaid([account_id]):::attr
    aJELdeb([debit]):::attr
    aJELcred([credit]):::attr

    %% Account Attributes
    aAid([id]):::attr
    aAcode([code]):::attr
    aAname([name]):::attr
    aAtype([type]):::attr
    aAparent([parent_id]):::attr
    aAbal([balance]):::attr

    %% Product Attributes
    aProId([id]):::attr
    aProSku([sku]):::attr
    aProName([name]):::attr
    aProCatId([category_id]):::attr
    aProSupId([supplier_id]):::attr
    aProUnitPrice([unit_price]):::attr
    aProCostPrice([cost_price]):::attr
    aProReorderLvl([reorder_level]):::attr
    aProImageUrl([image_url]):::attr
    aProIsActive([is_active]):::attr

    %% Category Attributes
    aCatId([id]):::attr
    aCatName([name]):::attr
    aCatDesc([description]):::attr
    aCatParentId([parent_id]):::attr

    %% Supplier Attributes
    aSupId([id]):::attr
    aSupName([name]):::attr
    aSupContact([contact_person]):::attr
    aSupEmail([email]):::attr
    aSupPhone([phone]):::attr
    aSupAddress([address]):::attr
    aSupIsActive([is_active]):::attr

    %% Stock Movement Attributes
    aSMId([id]):::attr
    aSMProdId([product_id]):::attr
    aSMType([type]):::attr
    aSMQty([quantity]):::attr
    aSMRefType([reference_type]):::attr
    aSMRefId([reference_id]):::attr
    aSMDate([date]):::attr
    aSMNotes([notes]):::attr

    %% Purchase Order Attributes
    aPOId([id]):::attr
    aPOPoNum([po_number]):::attr
    aPOSupId([supplier_id]):::attr
    aPODate([date]):::attr
    aPOStatus([status]):::attr
    aPOTotal([total_amount]):::attr
    aPOExpDate([expected_date]):::attr

    %% Purchase Order Line Attributes
    aPOLId([id]):::attr
    aPOLOrderId([order_id]):::attr
    aPOLProdId([product_id]):::attr
    aPOLQty([quantity]):::attr
    aPOLUnitPrice([unit_price]):::attr
    aPOLLineTotal([line_total]):::attr
    aPOLRecQty([received_qty]):::attr

    %% ===== ATTRIBUTE CONNECTIONS =====
    %% HR Attributes
    eUser --- aUId
    eUser --- aUEmail
    eUser --- aUPassword
    eUser --- aURoleId
    eUser --- aUEmpId
    eUser --- aUActive
    eUser --- aUCAt
    eUser --- aUUpAt

    eRole --- aRId
    eRole --- aRName
    eRole --- aRPermissions

    eEmployee --- aEmpId
    eEmployee --- aEmpUserId
    eEmployee --- aEmpFirst
    eEmployee --- aEmpLast
    eEmployee --- aEmpEmail
    eEmployee --- aEmpPhone
    eEmployee --- aEmpHireDate
    eEmployee --- aEmpSalary
    eEmployee --- aEmpDept
    eEmployee --- aEmpPos

    eAttendance --- aAttId
    eAttendance --- aAttEmpId
    eAttendance --- aAttDate
    eAttendance --- aAttCheckIn
    eAttendance --- aAttCheckOut
    eAttendance --- aAttStatus
    eAttendance --- aAttNotes

    eLeaveRequest --- aLRId
    eLeaveRequest --- aLREmpId
    eLeaveRequest --- aLRStart
    eLeaveRequest --- aLREnd
    eLeaveRequest --- aLRType
    eLeaveRequest --- aLRStatus
    eLeaveRequest --- aLRReason
    eLeaveRequest --- aLRApprovedBy
    eLeaveRequest --- aLRApprovedAt

    %% Sales & Accounting Attributes
    eCustomer --- aCid
    eCustomer --- aCname
    eCustomer --- aCemail
    eCustomer --- aCphone
    eCustomer --- aCaddress
    eCustomer --- aCcLimit
    eCustomer --- aCpTerms
    eCustomer --- aCcActive

    eSalesOrder --- aSOid
    eSalesOrder --- aSOoNum
    eSalesOrder --- aSOcId
    eSalesOrder --- aSOdate
    eSalesOrder --- aSOstatus
    eSalesOrder --- aSOta
    eSalesOrder --- aSOnotes

    eSalesOrderLine --- aSOLid
    eSalesOrderLine --- aSOLoid
    eSalesOrderLine --- aSOLpId
    eSalesOrderLine --- aSOLqty
    eSalesOrderLine --- aSOLprice
    eSalesOrderLine --- aSOLlineT

    eInvoice --- aIid
    eInvoice --- aInum
    eInvoice --- aIsoid
    eInvoice --- aIdate
    eInvoice --- aIdDue
    eInvoice --- aIstatus
    eInvoice --- aItotal
    eInvoice --- aItax

    ePayment --- aPid
    ePayment --- aPinvId
    ePayment --- aPamount
    ePayment --- aPdate
    ePayment --- aPmethod
    ePayment --- aPref
    ePayment --- aPnotes

    eJournalEntry --- aJEid
    eJournalEntry --- aJEdate
    eJournalEntry --- aJEdesc
    eJournalEntry --- aJEref
    eJournalEntry --- aJEstatus
    eJournalEntry --- aJEcBy
    eJournalEntry --- aJEcAt

    eJournalEntryLine --- aJELid
    eJournalEntryLine --- aJELeid
    eJournalEntryLine --- aJELaid
    eJournalEntryLine --- aJELdeb
    eJournalEntryLine --- aJELcred

    eAccount --- aAid
    eAccount --- aAcode
    eAccount --- aAname
    eAccount --- aAtype
    eAccount --- aAparent
    eAccount --- aAbal

    %% Inventory Attributes
    eProduct --- aProId
    eProduct --- aProSku
    eProduct --- aProName
    eProduct --- aProCatId
    eProduct --- aProSupId
    eProduct --- aProUnitPrice
    eProduct --- aProCostPrice
    eProduct --- aProReorderLvl
    eProduct --- aProImageUrl
    eProduct --- aProIsActive

    eCategory --- aCatId
    eCategory --- aCatName
    eCategory --- aCatDesc
    eCategory --- aCatParentId

    eSupplier --- aSupId
    eSupplier --- aSupName
    eSupplier --- aSupContact
    eSupplier --- aSupEmail
    eSupplier --- aSupPhone
    eSupplier --- aSupAddress
    eSupplier --- aSupIsActive

    eStockMovement --- aSMId
    eStockMovement --- aSMProdId
    eStockMovement --- aSMType
    eStockMovement --- aSMQty
    eStockMovement --- aSMRefType
    eStockMovement --- aSMRefId
    eStockMovement --- aSMDate
    eStockMovement --- aSMNotes

    ePurchaseOrder --- aPOId
    ePurchaseOrder --- aPOPoNum
    ePurchaseOrder --- aPOSupId
    ePurchaseOrder --- aPODate
    ePurchaseOrder --- aPOStatus
    ePurchaseOrder --- aPOTotal
    ePurchaseOrder --- aPOExpDate

    ePurchaseOrderLine --- aPOLId
    ePurchaseOrderLine --- aPOLOrderId
    ePurchaseOrderLine --- aPOLProdId
    ePurchaseOrderLine --- aPOLQty
    ePurchaseOrderLine --- aPOLUnitPrice
    ePurchaseOrderLine --- aPOLLineTotal
    ePurchaseOrderLine --- aPOLRecQty

    %% ===== ORTHOGONAL RELATIONSHIP CONNECTIONS =====
    %% HR Relationships
    eRole -->|1| rAssignedTo
    rAssignedTo -->|N| eUser

    eUser -->|1| rHas
    rHas -->|1| eEmployee

    eEmployee -->|1| rRecordsAttendance
    rRecordsAttendance -->|N| eAttendance

    eEmployee -->|1| rSubmitsLeave
    rSubmitsLeave -->|N| eLeaveRequest

    %% Sales Relationships
    eCustomer -->|1| rPlaces
    rPlaces -->|N| eSalesOrder

    eSalesOrder -->|1| rContains
    rContains -->|N| eSalesOrderLine

    eSalesOrder -->|1| rGenerates
    rGenerates -->|N| eInvoice

    eInvoice -->|1| rSettledBy
    rSettledBy -->|N| ePayment

    eSalesOrderLine -->|N| rProductFor
    rProductFor -->|1| eProduct

    %% Accounting Relationships
    eJournalEntry -->|1| rRecordsTo
    rRecordsTo -->|N| eJournalEntryLine

    eJournalEntryLine -->|N| rAffects
    rAffects -->|1| eAccount

    eAccount -->|1| rSubaccountOf
    rSubaccountOf -->|N| eAccount

    eUser -->|1| rCreatedBy
    rCreatedBy -->|N| eJournalEntry

    %% Inventory Relationships
    eCategory -->|1| rBelongsTo
    rBelongsTo -->|N| eProduct

    eSupplier -->|1| rSuppliedBy
    rSuppliedBy -->|N| eProduct

    eProduct -->|1| rTracks
    rTracks -->|N| eStockMovement

    ePurchaseOrder -->|1| rHasLines
    rHasLines -->|N| ePurchaseOrderLine

    ePurchaseOrderLine -->|N| rIncludesProduct
    rIncludesProduct -->|1| eProduct

    %% Cross-module Relationships (Connecting BE1, BE2, BE3)
    eEmployee -->|1| rManages
    rManages -->|N| ePurchaseOrder

    eSalesOrderLine -->|N| rUpdatesStock
    rUpdatesStock -->|1| eStockMovement