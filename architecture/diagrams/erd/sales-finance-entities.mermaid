flowchart TD
    classDef highlight fill:#d3d3d3,stroke:#ff0000,stroke-width:2px,stroke-dasharray:5 5
    classDef pk font-weight:bold,fill:#f0f0f0

    eCustomer[CUSTOMER]
    eSalesOrder[SALES ORDER]
    eSalesOrderLine[SALES ORDER LINE]
    eInvoice[INVOICE]
    ePayment[PAYMENT]
    eJournalEntry[JOURNAL ENTRY]
    eJournalEntryLine[JOURNAL ENTRY LINE]
    eAccount[ACCOUNT]
    eUser[USER - BE3]:::highlight
    eProduct[PRODUCT - BE1]:::highlight

    rPlaces[s11]
    rContains[s12]
    rProductFor[s13]:::highlight
    rGenerates[s14]
    rSettledBy[s15]
    rRecordsTo[s16]
    rAffects[s17]
    rSubaccountOf[s18]
    rCreatedBy[s19]:::highlight

    aCid((id)):::underline
    aCname((name))
    aCemail((email))
    aCphone((phone))
    aCaddress((address))
    aCcLimit((credit_limit))
    aCcActive((is_active))
    aCpTerms((payment_terms))

    aSOid((id)):::underline
    aSOstatus((status))
    aSOdate((date))
    aSOoNum((order_number))
    aSOcId((customer_id))
    aSOta((total_amount))
    aSOnotes((notes))

    aSOLid((id)):::underline
    aSOLoid((order_id))
    aSOLpId((product_id))
    aSOLqty((quantity))
    aSOLprice((unit_price))
    aSOLlineT((line_total))

    aIid((id)):::underline
    aInum((invoice_number))
    aIsoid((sales_order_id))
    aIdate((date))
    aIdDue((due_date))
    aIstatus((status))
    aItotal((total))
    aItax((tax_amount))

    aPid((id)):::underline
    aPinvId((invoice_id))
    aPdate((date))
    aPmethod((method))
    aPref((reference))
    aPnotes((notes))

    aJEid((id)):::underline
    aJEdate((date))
    aJEdesc((description))
    aJEref((reference))
    aJEstatus((status))
    aJEcBy((created_by))
    aJEcAt((created_at))

    aJELid((id)):::underline
    aJELeid((entry_id))
    aJELaid((account_id))
    aJELdeb((debit))
    aJELcred((credit))

    aAid((id)):::underline
    aAcode((code))
    aAname((name))
    aAtype((type))
    aAparent((parent_id))
    aAbal((balance))

    aUId((id)):::underline
    aProDid((id)):::underline

    eCustomer --- aCid
    eCustomer --- aCname
    eCustomer --- aCemail
    eCustomer --- aCphone
    eCustomer --- aCaddress
    eCustomer --- aCcLimit
    eCustomer --- aCcActive
    eCustomer --- aCpTerms

    eSalesOrder --- aSOid
    eSalesOrder --- aSOstatus
    eSalesOrder --- aSOdate
    eSalesOrder --- aSOoNum
    eSalesOrder --- aSOcId
    eSalesOrder --- aSOta
    eSalesOrder --- aSOnotes

    eSalesOrderLine --- aSOLid
    eSalesOrderLine --- aSOLoid
    eSalesOrderLine --- aSOLpId
    eSalesOrderLine --- aSOLqty
    eSalesOrderLine --- aSOLprice
    eSalesOrderLine --- aSOLlineT

    eInvoice --- aIid
    eInvoice --- aInum
    eInvoice --- aIsoid
    eInvoice --- aIdate
    eInvoice --- aIdDue
    eInvoice --- aIstatus
    eInvoice --- aItotal
    eInvoice --- aItax

    ePayment --- aPid
    ePayment --- aPinvId
    ePayment --- aPdate
    ePayment --- aPmethod
    ePayment --- aPref
    ePayment --- aPnotes

    eJournalEntry --- aJEid
    eJournalEntry --- aJEdate
    eJournalEntry --- aJEdesc
    eJournalEntry --- aJEref
    eJournalEntry --- aJEstatus
    eJournalEntry --- aJEcBy
    eJournalEntry --- aJEcAt

    eJournalEntryLine --- aJELid
    eJournalEntryLine --- aJELeid
    eJournalEntryLine --- aJELaid
    eJournalEntryLine --- aJELdeb
    eJournalEntryLine --- aJELcred

    eAccount --- aAid
    eAccount --- aAcode
    eAccount --- aAname
    eAccount --- aAtype
    eAccount --- aAparent
    eAccount --- aAbal

    eUser --- aUId
    eProduct --- aProDid

    eCustomer -->|1| rPlaces -->|N| eSalesOrder
    eSalesOrder -->|1| rContains -->|N| eSalesOrderLine
    eSalesOrder -->|1| rGenerates -->|N| eInvoice
    eInvoice -->|1| rSettledBy -->|N| ePayment
    eSalesOrderLine -->|N| rProductFor -->|1| eProduct
    eJournalEntry -->|1| rRecordsTo -->|N| eJournalEntryLine
    eJournalEntryLine -->|N| rAffects -->|1| eAccount
    eAccount -->|1| rSubaccountOf -->|N| eAccount
    eUser -->|1| rCreatedBy -->|N| eJournalEntry
